# Optional development overrides: docker compose up --build works without .env.
# Production: replace database/admin credentials, configure HTTPS with
# COOKIE_SECURE=true, restrict ALLOWED_ORIGINS and back up the secrets volume.
# Keep existing JWT_SECRET/ENCRYPTION_KEY when upgrading an existing deployment.
# Production: explicitly configure independent JWT_SECRET and ENCRYPTION_KEY.

# PostgreSQL and Adminer (development defaults)
POSTGRES_DB=research
POSTGRES_USER=research
POSTGRES_PASSWORD=research
# Set a URL-encoded DATABASE_URL when using special characters in DB credentials.
# DATABASE_URL=postgresql+psycopg://research:research@postgres:5432/research

# Initial administrator, created/promoted on startup; existing passwords stay unchanged.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=administrator-password

# Omit these to generate random keys once in the persistent uploads volume.
# Explicit values take precedence. Never replace an existing encryption key.
# JWT_SECRET=
# ENCRYPTION_KEY=
# Compose default: /data/uploads/.local-secrets.json; direct backend: data/local-secrets.json
# LOCAL_SECRETS_FILE=/data/uploads/.local-secrets.json

COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173
MAX_UPLOAD_MB=25
ALLOW_PRIVATE_API_ENDPOINTS=false
