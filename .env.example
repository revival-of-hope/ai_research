# PostgreSQL and Adminer
POSTGRES_DB=research
POSTGRES_USER=research
POSTGRES_PASSWORD=replace-with-a-long-database-password
DATABASE_URL=postgresql+psycopg://research:replace-with-a-long-database-password@postgres:5432/research

# Initial administrator, created or promoted on backend startup
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-at-least-10-characters

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-random-jwt-secret
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace-with-a-valid-fernet-key

COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173
MAX_UPLOAD_MB=25
ALLOW_PRIVATE_API_ENDPOINTS=false
